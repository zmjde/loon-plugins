#!name=中国联通净化[墨鱼版]
#!desc=使用前请卸载中国联通，挂载脚本然后使用
#!author=@ddgksf2013
#!note=jsonjq 规则已转为 JS 实现 (Minis)
#!homepage=https://raw.githubusercontent.com/ddgksf2013/Rewrite/refs/heads/master/AdBlock/ChinaUnicomAds.conf

[Rewrite]
^https?:\/\/m\.client\.10010\.com\/mobileserviceimportant\/customer\/querySmartServicekhd.htm url reject
^https?:\/\/m\.client\.10010\.com\/clientIndex\/api\/v1\/index\/queryIndexExclusiveOffers url reject
^https?:\/\/img\.client\.10010\.com\/homejingxuan12\/js\/(pubuliu|1homeView) url reject

[Rule]
DOMAIN-SUFFIX,ad.10010.com,REJECT

[Script]
http-response ^https?://(?:m\.client\.10010\.com|img\.client\.10010\.com)/ script-path=https://raw.githubusercontent.com/zmjde/loon-plugins/main/Script/ChinaUnicomAds.js, requires-body=true, max-size=-1, timeout=60

[Mitm]
hostname = m.client.10010.com,img.client.10010.com
