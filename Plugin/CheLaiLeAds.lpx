#!name=车来了(小程序)净化[墨鱼版]
#!desc=使用前请卸载汽水音乐，挂载脚本然后使用
#!author=@ddgksf2013
#!homepage=https://raw.githubusercontent.com/ddgksf2013/Rewrite/refs/heads/master/AdBlock/CheLaiLeAds.conf

[Rewrite]
^https?:\/\/.*chelaile\.net\.cn\/goocity\/flowPos\/listByPos url reject
^https?:\/\/cdn\.web\.chelaile\.net\.cn\/info-flow\/index\.html url reject-200
^https?:\/\/.*chelaile\.net\.cn\/(api\/)?adpub url reject-200
^https?:\/\/124\.70\.194\.16\/(ip|adpub) url reject-200
^https?:\/\/124\.70\.194\.16\/goocity\/flowPos\/listByPos url reject-200
^https?:\/\/web\.chelaile\.net\.cn\/api\/operative_position\/infoflow url reject-200
^https?:\/\/atrace\.chelaile\.net\.cn\/(wx_preloadAd|adAnalysis) url reject-200

[Script]
http-response ^https?:\/\/.*chelaile\.net\.cn\/goocity\/city! script-path=https://raw.githubusercontent.com/zmjde/loon-plugins/main/JS/Ext/chelaile.js, requires-body=true, timeout=60

[Mitm]
hostname = web.chelaile.net.cn,api.chelaile.net.cn,cdn.api.chelaile.net.cn,cdn.web.chelaile.net.cn,atrace.chelaile.net.cn
