#!name=Bing首页简化[墨鱼版]
#!desc=如需引用请注明出处，谢谢合作！
#!author=@ddgksf2013
#!homepage=https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/BingSimplify.conf

[Rewrite]
^https?:\/\/assets\.msn\.com\/service\/weather\/locations\/search url reject-dict
^https:\/\/assets\.msn\.com\/service\/news\/feed\/pages\/startmhp url reject-dict
^https?:\/\/api\.msn\.com\/weather url reject-dict

[Script]
http-response ^https?:\/\/sapphire\.api\.microsoftapp\.net\/config\/api\/v1\/get script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/bing.js, requires-body=true, timeout=60

[Mitm]
hostname = sapphire.api.microsoftapp.net,assets.msn.com,api.msn.com
