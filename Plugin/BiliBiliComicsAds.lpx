#!name=哔哩哔哩漫画净化[墨鱼版]
#!desc=使用前请卸载哔哩哔哩漫画，挂载脚本然后使用
#!author=@ddgksf2013
#!note=jsonjq 规则已转为 JS 实现 (Minis)
#!homepage=https://raw.githubusercontent.com/ddgksf2013/Rewrite/refs/heads/master/AdBlock/BiliBiliComicsAds.conf

[Rewrite]

[Script]
http-response ^https?://(?:manga\.bilibili\.com)/ script-path=https://raw.githubusercontent.com/zmjde/loon-plugins/main/Script/BiliBiliComicsAds.js, requires-body=true, max-size=-1, timeout=60

[Mitm]
hostname = manga.bilibili.com
